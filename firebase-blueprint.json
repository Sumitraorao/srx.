{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and role info",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Manager", "Sales Rep", "Viewer"] },
        "avatar": { "type": "string" }
      }
    },
    "Contact": {
      "title": "Contact",
      "description": "Individual person or business contact",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "company": { "type": "string" },
        "source": { "type": "string" },
        "tags": { "type": "array" }
      }
    },
    "Lead": {
      "title": "Lead",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["New", "Contacted", "Qualified", "Lost"] },
        "score": { "type": "number" },
        "value": { "type": "number" },
        "ownerId": { "type": "string" }
      }
    },
    "Deal": {
        "title": "Deal",
        "type": "object",
        "properties": {
            "name": { "type": "string" },
            "amount": { "type": "number" },
            "stage": { "type": "string" },
            "expectedCloseDate": { "type": "string" },
            "probability": { "type": "number" }
        }
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "System users" },
    "/contacts/{contactId}": { "schema": "Contact", "description": "CRM Contacts" },
    "/leads/{leadId}": { "schema": "Lead", "description": "Sales Leads" },
    "/deals/{dealId}": { "schema": "Deal", "description": "Pipeline Deals" },
    "/tasks/{taskId}": { "schema": "Task", "description": "Activities" }
  }
}
